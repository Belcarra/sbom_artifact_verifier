%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB\VID_15ec&PID_d032
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB2\VID_15ec&PID_d032
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB3\VID_15ec&PID_d032
