%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB3\VID_15ec&PID_d040
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB\VID_15ec&PID_d041
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB2\VID_15ec&PID_d041
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB3\VID_15ec&PID_d041
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB\VID_15ec&PID_d042
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB2\VID_15ec&PID_d042
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB3\VID_15ec&PID_d042
[BelcarraDemo.NTARM64.10.0]
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB\VID_15ec&PID_d030
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB2\VID_15ec&PID_d030
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB3\VID_15ec&PID_d030
%BTCUsbLan.DeviceDesc% = BTCUsbLan.ndi, USB\VID_15ec&PID_d031
